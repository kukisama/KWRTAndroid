<?xml version="1.0" encoding="utf-8"?>
<!-- 允许任意域名 http 明文 + 用户证书；家用路由器常用 http://192.168.x.x 或自签 https。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
