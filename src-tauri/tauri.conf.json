{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KWRT Controller",
  "version": "0.1.0",
  "identifier": "io.kwrt.controller",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KWRT Controller",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "none",
    "icon": []
  }
}
